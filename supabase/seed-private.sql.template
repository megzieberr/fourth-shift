-- Megan (admin — can delete cards)
insert into public.members (id, username, display_name, ink, is_admin)
select id, 'megan', 'Megan', '#C93F2A', true
from auth.users where email = 'megan@fourth-shift.app'
on conflict (id) do update set display_name = excluded.display_name, ink = excluded.ink;

-- Member 2 — replace username + display name (first name or initials only)
insert into public.members (id, username, display_name, ink, is_admin)
select id, 'USERNAME2', 'FIRSTNAME2', '#2E6C9E', false
from auth.users where email = 'USERNAME2@fourth-shift.app'
on conflict (id) do update set display_name = excluded.display_name, ink = excluded.ink;

